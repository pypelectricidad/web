---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PyP Electricidad S.R.L.',
  description = 'Materiales eléctricos, obras electromecánicas e integración de tableros. Empresa tucumana con más de 15 años de experiencia.',
} = Astro.props;

const site = Astro.site?.toString() ?? 'https://pypelectricidad.github.io';
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const canonical = new URL(Astro.url.pathname, site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Google Analytics (GA4) -->
    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-PBEJ0P0E6E" async></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-PBEJ0P0E6E');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
