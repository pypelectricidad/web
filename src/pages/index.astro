---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const img = (name) => `${base}images/${name}`;

// Pilares: Provisión + Soluciones
const provision = [
  'Materiales eléctricos',
  'Iluminación',
  'Insumos y componentes especializados',
  'Productos eléctricos normalizados',
];

const solutions = [
  'Integración de tableros eléctricos',
  'Automatización y control',
  'Servicios electromecánicos',
  'Mantenimiento eléctrico',
  'Proyección e instalaciones de mediana y gran escala',
];

// Proceso completo
const process = [
  { num: '01', label: 'Necesidad', desc: 'Detectamos el requerimiento del cliente.' },
  { num: '02', label: 'Selección', desc: 'Elegimos los materiales adecuados.' },
  { num: '03', label: 'Solución técnica', desc: 'Diseñamos la solución a medida.' },
  { num: '04', label: 'Provisión', desc: 'Suministramos los componentes.' },
  { num: '05', label: 'Ejecución', desc: 'Puesta en marcha del proyecto.' },
  { num: '06', label: 'Mantenimiento', desc: 'Mantenimiento programado continuo.' },
];

// Sectores que atendemos
const sectors = [
  { name: 'Industria', icon: 'factory' },
  { name: 'Minería', icon: 'mine' },
  { name: 'Energía', icon: 'energy' },
  { name: 'Construcción', icon: 'construction' },
  { name: 'Plantas industriales', icon: 'plant' },
  { name: 'Ingenierías', icon: 'engineering' },
  { name: 'Mantenimiento', icon: 'maintenance' },
];

// Personalidad de marca
const traits = [
  { name: 'Técnica', desc: 'Conocemos los productos y las necesidades detrás de cada proyecto.' },
  { name: 'Industrial', desc: 'Nuestra experiencia y clientes van más allá del comercio minorista.' },
  { name: 'Cercana', desc: 'Mantenemos una relación accesible y humana, con grandes y pequeños.' },
  { name: 'Confiable', desc: 'Demostramos experiencia, productos, servicio y procesos de calidad.' },
];

// Respaldo
const backing = [
  'Experiencia en el sector',
  'Conocimiento técnico',
  'Trabajo en proyectos industriales',
  'Obras y plantas de gran envergadura',
  'Relación con marcas y proveedores destacados',
  'Experiencia en entornos exigentes',
  'Cobertura regional y local (NOA)',
  'Certificaciones ISO 9001, ISO 14001 e ISO 45001',
];

// Servicios con imágenes
const services = [
  {
    num: '01',
    title: 'Integración de tableros',
    desc: 'Diseñamos soluciones que optimizan el rendimiento y aseguran un flujo eléctrico constante.',
    image: 'servicio-tableros.jpg',
  },
  {
    num: '02',
    title: 'Automatismo industrial',
    desc: 'Soluciones que aumentan la eficiencia, reducen costos y garantizan precisión y continuidad operativa.',
    image: 'servicio-automatismo.jpg',
  },
  {
    num: '03',
    title: 'Obras electromecánicas',
    desc: 'Enfoque integral que garantiza la eficiencia y la seguridad en cada proyecto.',
    image: 'servicio-obras.jpg',
  },
];

const partners = ['ABB', 'BAEL', 'Delga', 'LCT', 'Rockwell', 'Gevelux', 'Zoloda', 'Tecnocom', 'San Justo'];

// Últimas publicaciones de Instagram @pyp.electricidad
const igPosts = [
  { shortcode: 'Dcyna5TFmgQ', date: '02 Sep 2026', isVideo: false, caption: 'Una nueva sucursal, una nueva instalación eléctrica. Gracias a Felfit por confiar en PyP Electricidad para la apertura de su nueva sucursal en el microcentro tucumano.' },
  { shortcode: 'DclsIhFlhgt', date: '28 Ago 2026', isVideo: false, caption: 'Hay cosas que no se pueden resolver mirando un plano. Antes de presupuestar, antes de elegir materiales y antes de empezar a instalar… hay que conocer la obra.' },
  { shortcode: 'DcToW4RlvW8', date: '21 Ago 2026', isVideo: false, caption: 'Visita de obra: el proyecto empieza antes de instalar.' },
  { shortcode: 'Db_en1mMdzt', date: '13 Ago 2026', isVideo: true, caption: 'Novedades en seguridad eléctrica: dispositivo de extinción de aerosol.' },
  { shortcode: 'Db8SPJMlqEy', date: '12 Ago 2026', isVideo: false, caption: 'Agosto, mes de la Pachamama. Cuidar del ambiente es parte de la responsabilidad con el lugar donde trabajamos. ISO 14001 | Gestión ambiental.' },
  { shortcode: 'DboE6kOxwtg', date: '04 Ago 2026', isVideo: false, caption: 'Reemplazo de bandejas portacables con base confiable.' },
  { shortcode: 'Dbdo_AwFurA', date: '31 Jul 2026', isVideo: false, caption: 'Mantenimiento de UPS en Supercanal Tucumán. Una falla al momento de funcionar implica un alto costo.' },
  { shortcode: 'DbToEQzFuBM', date: '27 Jul 2026', isVideo: false, caption: 'Trabajá de forma segura con PyP Electricidad. Línea de Elementos de Protección Personal (EPP).' },
  { shortcode: 'DbA8Dv_ljqg', date: '20 Jul 2026', isVideo: false, caption: 'Trabajos realizados en planta industrial.' },
  { shortcode: 'Dauwocpljy1', date: '10 Jul 2026', isVideo: false, caption: 'Trabajador electricista realizando ajustes en un tablero eléctrico industrial.' },
];

const productCategories = [
  { name: 'Iluminación', image: 'producto-panel-led.jpg', family: 'iluminacion' },
  { name: 'Protección', image: 'producto-termomagnetica.jpg', family: 'proteccion-distribucion' },
  { name: 'Automatización', image: 'producto-contactores.jpg', family: 'automatizacion-control' },
  { name: 'Conductores', image: 'producto-cables.jpg', family: 'conductores-conexion' },
  { name: 'Canalización', image: 'producto-bandeja.jpg', family: 'canalizacion' },
  { name: 'Puesta a tierra', image: 'producto-jabalina.jpg', family: 'puesta-a-tierra' },
  { name: 'Emergencia', image: 'producto-luz-emergencia.jpg', family: 'iluminacion' },
  { name: 'Gabinetes', image: 'producto-transformador.jpg', family: 'gabinetes-tableros' },
  { name: 'Antiexplosivos', image: 'producto-interruptores.jpg', family: 'antiexplosivos' },
];
---

<BaseLayout>
  <Header />

  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-screen items-center overflow-hidden bg-steel-900 pt-20">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0">
      <img src={img('hero-frente-local.jpg')} alt="Frente del local PyP Electricidad" class="h-full w-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-r from-steel-900 via-steel-900/85 to-steel-900/40"></div>
    </div>

    <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-30"></div>
    <div class="absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-brand/20 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 border border-brand/30 bg-steel-800/50 px-3 py-1.5 md:mb-6 md:px-4 md:py-2">
            <span class="h-2 w-2 animate-pulse-slow bg-brand-light"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-brand-light md:text-xs md:tracking-[0.25em]">San Miguel de Tucumán · NOA · Argentina</span>
          </div>

          <h1 class="font-display text-4xl font-bold leading-[0.95] text-white sm:text-5xl md:text-7xl">
            Conectamos
            <span class="block text-brand">energía</span>
            <span class="block text-brand-light">y calidad</span>
          </h1>

          <p class="mt-6 max-w-lg text-base leading-relaxed text-slate-300 md:mt-8 md:text-lg">
            Empresa eléctrica <span class="font-bold text-white">integral</span>: provisión de materiales
            y soluciones electromecánicas para industria, minería, energía y construcción.
            Más de <span class="font-bold text-brand-light">15 años</span> de experiencia técnica.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 md:mt-10 md:gap-4">
            <a
              href={`${base}#contacto`}
              class="group relative bg-brand px-6 py-3 font-display text-xs font-bold uppercase tracking-wider text-white transition-all hover:bg-brand-light md:px-8 md:py-4 md:text-sm"
            >
              Solicitar presupuesto
              <span class="ml-2 inline-block transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a
              href={`${base}servicios`}
              class="border border-brand/40 px-6 py-3 font-display text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-brand hover:bg-brand/10 md:px-8 md:py-4 md:text-sm"
            >
              Ver soluciones
            </a>
          </div>

          <div class="mt-10 grid grid-cols-3 gap-4 border-t border-steel-700 pt-6 md:mt-14 md:gap-6 md:pt-8">
            <div>
              <div class="font-display text-2xl font-bold text-brand md:text-3xl">15+</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-slate-500 md:text-xs">Años</div>
            </div>
            <div>
              <div class="font-display text-2xl font-bold text-brand md:text-3xl">3</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-slate-500 md:text-xs">ISO</div>
            </div>
            <div>
              <div class="font-display text-2xl font-bold text-brand md:text-3xl">NOA</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-slate-500 md:text-xs">Cobertura</div>
            </div>
          </div>
        </div>

        <div class="relative hidden lg:block">
          <div class="industrial-corner relative aspect-square overflow-hidden border border-brand/20 bg-steel-800">
            <img src={img('frente-local.jpg')} alt="Frente del local PyP Electricidad" class="h-full w-full object-cover opacity-80" />
            <div class="absolute inset-0 bg-gradient-to-t from-steel-900 via-transparent to-transparent"></div>
            <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>
            <div class="absolute left-4 top-4 font-mono text-xs text-brand-light/80">PyP_HEADQUARTERS</div>
            <div class="absolute bottom-4 right-4 font-mono text-xs text-brand-light/80">Tucumán · AR</div>
          </div>
          <div class="absolute -bottom-4 -left-4 bg-brand-light px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-white">
            ● Sistema activo
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <div class="flex flex-col items-center gap-2">
        <span class="font-mono text-xs uppercase tracking-widest text-slate-500">Scroll</span>
        <div class="h-12 w-px bg-gradient-to-b from-brand to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- ============ QUÉ ES PyP ============ -->
  <section class="relative bg-steel-800 py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-16 max-w-3xl">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">01 / Qué somos</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
          No solo vendemos. <span class="text-brand">Resolvemos.</span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-400">
          PyP Electricidad es una empresa especializada en la comercialización de materiales eléctricos
          y el desarrollo de soluciones eléctricas y electromecánicas, con orientación a la industria
          y a proyectos de gran exigencia técnica. No somos una ferretería: somos una empresa eléctrica integral.
        </p>
      </div>

      <!-- Dos pilares -->
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Provisión -->
        <div class="industrial-corner border border-steel-600 bg-steel-900 p-8">
          <div class="mb-6 flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center border border-brand/30 bg-brand/10">
              <svg class="h-6 w-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7h18M3 12h18M3 17h18M7 7v10M17 7v10" /></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-white">Provisión</h3>
          </div>
          <ul class="space-y-3">
            {provision.map((p) => (
              <li class="flex items-start gap-3 text-slate-300">
                <span class="mt-1 text-brand">▸</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Soluciones -->
        <div class="industrial-corner border border-brand-light/30 bg-steel-900 p-8">
          <div class="mb-6 flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center border border-brand-light/30 bg-brand-light/10">
              <svg class="h-6 w-6 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="font-display text-2xl font-bold text-white">Soluciones</h3>
          </div>
          <ul class="space-y-3">
            {solutions.map((s) => (
              <li class="flex items-start gap-3 text-slate-300">
                <span class="mt-1 text-brand-light">▸</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROCESO COMPLETO ============ -->
  <section class="relative overflow-hidden bg-steel-900 py-16 md:py-24">
    <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 max-w-3xl md:mb-16">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">02 / Cómo trabajamos</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
          Del principio <span class="text-brand">al fin</span>
        </h2>
        <p class="mt-6 text-lg text-slate-400">
          No nos limitamos a vender un componente. Participamos en todas las etapas de una necesidad eléctrica.
          Esta capacidad de resolver de principio a fin es lo que nos diferencia de un comercio tradicional.
        </p>
      </div>

      <!-- Timeline horizontal -->
      <div class="grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-4">
        {process.map((step, i) => (
          <div class="group relative border border-steel-600 bg-steel-800 p-4 transition-all hover:border-brand/50 md:p-5">
            <div class="font-mono text-xs text-brand-light/60">{step.num}</div>
            <div class="mt-2 font-display text-base font-bold text-white">{step.label}</div>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">{step.desc}</p>
            {i < process.length - 1 && (
              <div class="absolute -right-2 top-1/2 hidden h-4 w-4 -translate-y-1/2 items-center justify-center text-brand md:flex">
                →
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  <section id="servicios" class="relative bg-steel-800 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 flex flex-col items-start gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-3 flex items-center gap-3">
            <span class="h-px w-12 bg-brand-light"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">03 / Servicios</span>
          </div>
          <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
            Lo que <span class="text-brand">hacemos</span>
          </h2>
        </div>
        <p class="max-w-md text-slate-400">
          Soluciones integrales para la industria eléctrica del NOA. De la ingeniería al montaje.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
        {services.map((s) => (
          <article class="industrial-corner group relative overflow-hidden border border-steel-600 bg-steel-900 transition-all hover:border-brand/50">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img src={img(s.image)} alt={s.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-steel-900 via-steel-900/40 to-transparent"></div>
              <span class="absolute right-4 top-4 font-display text-5xl font-bold text-steel-700/60 transition-colors group-hover:text-brand/30">{s.num}</span>
            </div>
            <div class="p-6">
              <h3 class="mb-2 font-display text-xl font-bold text-white">{s.title}</h3>
              <p class="text-sm leading-relaxed text-slate-400">{s.desc}</p>
              <a href={`${base}servicios`} class="mt-4 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-brand-light transition-colors hover:text-brand-light">
                Ver más <span>→</span>
              </a>
            </div>
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-brand-light transition-all duration-500 group-hover:w-full"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SECTORES ============ -->
  <section class="relative bg-steel-900 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 max-w-3xl md:mb-16">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">04 / A quién atendemos</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
          Sectores que <span class="text-brand">servimos</span>
        </h2>
        <p class="mt-6 text-lg text-slate-400">
          Le hablamos tanto a quien necesita un producto como a quien necesita resolver un proyecto eléctrico de mayor escala.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4 lg:grid-cols-7">
        {sectors.map((s) => (
          <div class="group flex flex-col items-center justify-center border border-steel-600 bg-steel-800 p-4 text-center transition-all hover:border-brand hover:bg-brand/5 md:p-6">
            <div class="mb-3 flex h-10 w-10 items-center justify-center text-brand transition-transform group-hover:scale-110">
              {s.icon === 'factory' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V10l5 3V10l5 3V7l5 3v11" /></svg>}
              {s.icon === 'mine' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L4 9l8 13 8-13-8-7zM4 9h16" /></svg>}
              {s.icon === 'energy' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 2L3 14h7v8l10-12h-7V2z" /></svg>}
              {s.icon === 'construction' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M6 21V11l6-4 6 4v10M9 21v-6h6v6" /></svg>}
              {s.icon === 'plant' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V8h6v13M11 21V11h6v10M8 12h0M14 15h0" /></svg>}
              {s.icon === 'engineering' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19" /></svg>}
              {s.icon === 'maintenance' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 7l-5 5 5 5M19 7l-5 5 5 5" /></svg>}
            </div>
            <span class="text-xs font-medium text-slate-300 transition-colors group-hover:text-white">{s.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NOSOTROS + PERSONALIDAD ============ -->
  <section id="nosotros" class="relative overflow-hidden bg-steel-800 py-16 md:py-24">
    <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-20">
        <div>
          <div class="mb-3 flex items-center gap-3">
            <span class="h-px w-12 bg-brand-light"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">05 / Nosotros</span>
          </div>
          <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
            Una empresa <span class="text-brand">seria</span>, técnica y preparada
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-400">
            PyP Electricidad S.R.L. es una empresa tucumana con más de 15 años de experiencia.
            Buscamos la excelencia, el crecimiento y la satisfacción de nuestros clientes en cada proyecto.
          </p>

          <!-- Personalidad de marca -->
          <div class="mt-8 grid gap-3 sm:grid-cols-2 md:mt-10 md:gap-4">
            {traits.map((t) => (
              <div class="border border-steel-600 bg-steel-900 p-4 md:p-5">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 bg-brand-light"></span>
                  <h3 class="font-display text-lg font-bold text-white">{t.name}</h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">{t.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Imágenes + Respaldo -->
        <div class="flex flex-col gap-4 md:gap-6">
          <div class="grid gap-3 md:gap-4">
            <div class="industrial-corner relative aspect-video overflow-hidden border border-brand/20">
              <img src={img('nosotros-charla.jpg')} alt="Charla técnica PyP" class="h-full w-full object-cover" />
