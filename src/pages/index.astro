<script is:inline>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('contact-submit');
    const status = document.getElementById('contact-status');

    const payload = {
      _subject: `Consulta web: ${form.nombre.value}`,
      _template: 'table',
      _captcha: 'false',
      _honey: form._honey.value,
      _autoresponse: `Gracias por tu consulta, ${form.nombre.value}. Te responderemos a la brevedad. También podés enviarnos tu consulta por WhatsApp al +54 9 381 427 5594. — PyP Electricidad S.R.L.`,
      Nombre: form.nombre.value,
      Email: form.email.value,
      Mensaje: form.mensaje.value,
    };

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    status.classList.add('hidden');

    try {
      const res = await fetch('https://formsubmit.co/ajax/fbarriga@pyp-argentina.com.ar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || data.success !== 'true') throw new Error(data.message || 'HTTP ' + res.status);
      status.textContent = '✓ Consulta enviada. Le responderemos a la brevedad.';
      status.className = 'text-center text-sm text-emerald-400';
      form.reset();
    } catch {
      status.textContent = 'No se pudo enviar. Escribinos a fbarriga@pyp-argentina.com.ar';
      status.className = 'text-center text-sm text-red-400';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar consulta →';
    }
  });
</script>
