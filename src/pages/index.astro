---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-brand text-white">
      <div class="mx-auto max-w-6xl px-4 py-24 text-center">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
          Materiales eléctricos
        </h1>
        <p class="mt-4 text-lg text-white/80">
          Obras electromecánicas · Integración de tableros · Automatismo industrial
        </p>
        <p class="mt-6 max-w-2xl mx-auto text-white/70">
 Empresa tucumana con más de 15 años de experiencia. Sitio en construcción.
        </p>
      </div>
    </section>

    <!-- Placeholder -->
    <section class="mx-auto max-w-6xl px-4 py-16">
      <div class="rounded-lg border border-dashed border-slate-300 p-12 text-center text-slate-500">
        <p class="text-lg">Sitio en construcción</p>
        <p class="mt-2 text-sm">
          Proyecto Astro configurado y publicado en GitHub Pages. Próximamente se migrará el contenido
          desde <a href="https://www.pypelectricidad.com.ar" class="text-brand underline">pypelectricidad.com.ar</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
