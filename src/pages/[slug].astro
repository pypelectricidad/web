---
import Redirect from '../components/Redirect.astro';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

export function getStaticPaths() {
  // Legacy Wix single-segment URLs -> new destinations
  const MAP = {
    gabinetes: 'tienda/?familia=gabinetes-tableros',
    iluminacion: 'tienda/?familia=iluminacion',
    conductores: 'tienda/?familia=conductores-conexion',
    canalizacion: 'tienda/?familia=canalizacion',
    automycontrol: 'tienda/?familia=automatizacion-control',
    tierra: 'tienda/?familia=puesta-a-tierra',
    accesoriosind: 'tienda/?familia=fichas-tomas',
    transform: 'tienda/?familia=automatizacion-control',
    antiexplosivos: 'tienda/?familia=antiexplosivos',
    domicil: 'tienda/?familia=herramientas-domiciliario',
    'politica-etica-anticorrupcion': 'ayuda',
    politicasdegestionintegrada: 'ayuda',
    'copia-de-políticas-de-privacidad': 'ayuda',
    'copia-de-bases-y-condiciones-sorteo-n': '',
    'copia-de-bases-y-condiciones-sorteo-r': '',
    'sorteo-ventilador': '',
    'coming-soon-03': '',
    'coming-soon-03-1': '',
    'coming-soon-03-2': '',
    'coming-soon-03-3': '',
    'coming-soon-03-4': '',
    untratomuypositivo: '',
  };
  const rawBase = import.meta.env.BASE_URL ?? '/';
  const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
  return Object.entries(MAP).map(([slug, dest]) => ({
    params: { slug },
    props: { to: `${base}${dest}` },
  }));
}

const { to } = Astro.props;
---

<Redirect to={to} />
