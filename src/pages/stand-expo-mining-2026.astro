---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/stand-render.css';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const img = (name) => `${base}images/${name}`;
---

<BaseLayout title="Stand Expo Mining 2026 · 3×3 m · PyP Electricidad" description="Render fotorrealista del stand 3×3 m para Expo Mining 2026 de PyP Electricidad.">
  <main class="bg-steel-900 min-h-screen">
    <!-- Header compacto -->
    <header class="border-b border-brand/20 bg-steel-900/95 backdrop-blur-md sticky top-0 z-50">
      <div class="mx-auto max-w-7xl px-4 py-4 md:px-6 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href={base} class="group flex items-center">
            <img src={img('logo-pyp-white.png')} alt="PyP Electricidad" class="h-10 w-auto transition-opacity group-hover:opacity-80" />
          </a>
          <div class="h-6 w-px bg-steel-600 hidden sm:block"></div>
          <div class="hidden sm:block">
            <h1 class="font-display text-lg font-bold text-white leading-tight">Expo Mining 2026</h1>
            <p class="font-mono text-[10px] uppercase tracking-wider text-brand-light">Stand 3×3 m · Concepto vanguardista</p>
          </div>
        </div>
        <a href={`${base}contacto`} class="bg-brand px-5 py-2 font-display text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-brand-light">
          Solicitar stand
        </a>
      </div>
      <div class="h-[2px] w-full bg-gradient-to-r from-brand-dark via-brand to-brand-light opacity-60"></div>
    </header>

    <!-- Hero concepto -->
    <section class="relative overflow-hidden border-b border-steel-700 bg-steel-800 py-14">
      <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>
      <div class="absolute right-0 top-0 h-96 w-96 rounded-full bg-brand/20 blur-[120px]"></div>
      <div class="absolute left-0 bottom-0 h-72 w-72 rounded-full bg-brand-light/10 blur-[100px]"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">Concepto rediseñado · Alto impacto</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-6xl max-w-5xl leading-[0.95]">
          Portal <span class="text-brand">Energético</span><br />
          <span class="text-brand-light">PyP</span> · Expo Mining <span class="text-brand-light">2026</span>
        </h2>
        <p class="mt-6 max-w-2xl text-lg text-slate-400 leading-relaxed">
          Stand 3×3 m que rompe con el formato caja clásico. Dos torres inclinadas, un arco suspendido, pantallas LED curvas y un mostrador-isla en el centro. Diseñado para captar la atención en un salón de alto tráfico como Expo Mining.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <span class="border border-brand/30 bg-brand/10 px-4 py-2 font-mono text-xs uppercase tracking-wider text-brand-light">3,50 m de altura</span>
          <span class="border border-brand/30 bg-brand/10 px-4 py-2 font-mono text-xs uppercase tracking-wider text-brand-light">Superficie 9 m²</span>
          <span class="border border-brand/30 bg-brand/10 px-4 py-2 font-mono text-xs uppercase tracking-wider text-brand-light">Pantallas LED</span>
          <span class="border border-brand/30 bg-brand/10 px-4 py-2 font-mono text-xs uppercase tracking-wider text-brand-light">Suelo reflectante</span>
        </div>
      </div>
    </section>

    <!-- Render principal: Portal Energético PyP -->
    <section class="relative bg-steel-900 py-16 overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-10"></div>
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <div class="font-mono text-xs uppercase tracking-[0.2em] text-brand-light mb-2">Vista principal</div>
            <h3 class="font-display text-2xl font-bold text-white md:text-3xl">Perspectiva 3/4 · Estructura tipo portal</h3>
          </div>
          <span class="font-mono text-xs text-slate-500">Render SVG fotorrealista · Escala 1:25</span>
        </div>

        <div class="render-scene rounded-2xl border border-steel-600 bg-gradient-to-b from-steel-800 to-steel-900 p-2 md:p-6" style="min-height: 600px;">
          <svg viewBox="0 0 900 620" class="w-full max-w-6xl" aria-label="Render del stand Expo Mining 2026, concepto Portal Energético PyP" preserveAspectRatio="xMidYMid meet">
            <defs>
              <!-- Gradientes -->
              <linearGradient id="bg-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#0a1120" />
                <stop offset="100%" stop-color="#0f1620" />
              </linearGradient>
              <radialGradient id="spot-glow-grad" cx="50%" cy="0%" r="80%">
                <stop offset="0%" stop-color="rgba(0,185,242,0.25)" />
                <stop offset="60%" stop-color="rgba(24,142,243,0.08)" />
                <stop offset="100%" stop-color="transparent" />
              </radialGradient>
              <linearGradient id="tower-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#03246f" />
                <stop offset="50%" stop-color="#0a3b66" />
                <stop offset="100%" stop-color="#0c2742" />
              </linearGradient>
              <linearGradient id="metal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4a5d78" />
                <stop offset="50%" stop-color="#2c3a4d" />
                <stop offset="100%" stop-color="#1a2330" />
              </linearGradient>
              <linearGradient id="beam-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#273344" />
                <stop offset="50%" stop-color="#188ef3" />
                <stop offset="100%" stop-color="#03246f" />
              </linearGradient>
              <linearGradient id="floor-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#161f2c" />
                <stop offset="100%" stop-color="#0b1018" />
              </linearGradient>
              <linearGradient id="floor-glow-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="rgba(0,185,242,0)" />
                <stop offset="50%" stop-color="rgba(0,185,242,0.12)" />
                <stop offset="100%" stop-color="rgba(0,185,242,0)" />
              </linearGradient>
              <linearGradient id="screen-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0a0f16" />
                <stop offset="100%" stop-color="#1a2330" />
              </linearGradient>
              <linearGradient id="counter-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1e2a38" />
                <stop offset="50%" stop-color="#0f1620" />
                <stop offset="100%" stop-color="#1a2330" />
              </linearGradient>

              <!-- Patrones -->
              <pattern id="grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(24,142,243,0.10)" stroke-width="1" />
              </pattern>
              <pattern id="truss-pattern" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 0 0 L 20 20 M 20 0 L 0 20" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="0.8" />
              </pattern>
              <pattern id="circuit-pattern" width="60" height="60" patternUnits="userSpaceOnUse">
                <path d="M 0 30 L 30 30 L 30 0 M 30 30 L 60 30 L 60 60" fill="none" stroke="rgba(0,185,242,0.20)" stroke-width="1" />
                <circle cx="30" cy="30" r="2" fill="rgba(0,185,242,0.4)" />
                <circle cx="0" cy="30" r="2" fill="rgba(0,185,242,0.2)" />
                <circle cx="60" cy="30" r="2" fill="rgba(0,185,242,0.2)" />
              </pattern>

              <!-- Filtros -->
              <filter id="shadow-soft" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur in="SourceAlpha" stdDeviation="10" />
                <feOffset dx="0" dy="12" result="offsetblur" />
                <feComponentTransfer>
                  <feFuncA type="linear" slope="0.5" />
                </feComponentTransfer>
                <feMerge>
                  <feMergeNode />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="neon-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="5" result="coloredBlur" />
                <feMerge>
                  <feMergeNode in="coloredBlur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="light-beam" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="12" />
              </filter>
              <filter id="reflection-blur" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="6" />
              </filter>

              <!-- Máscaras para pantallas curvas -->
              <clipPath id="screen-clip-1">
                <path d="M 240 430 L 315 130 Q 335 125 355 130 L 300 430 Z" />
              </clipPath>
              <clipPath id="screen-clip-2">
                <path d="M 600 430 L 545 130 Q 565 125 585 130 L 660 430 Z" />
              </clipPath>
            </defs>

            <!-- Fondo -->
            <rect x="0" y="0" width="900" height="620" fill="url(#bg-grad)" />
            <rect x="0" y="0" width="900" height="620" fill="url(#spot-glow-grad)" opacity="0.6" />

            <!-- Partículas / nodos -->
            <circle cx="120" cy="100" r="2" fill="#00b9f2" opacity="0.4" />
            <circle cx="780" cy="120" r="3" fill="#188ef3" opacity="0.3" />
            <circle cx="200" cy="80" r="2" fill="#fff" opacity="0.2" />
            <circle cx="700" cy="90" r="2" fill="#00b9f2" opacity="0.25" />

            <!-- Suelo reflectante 3×3 -->
            <g>
              <polygon points="120,430 780,430 700,540 200,540" fill="url(#floor-grad)" stroke="rgba(24,142,243,0.3)" stroke-width="1" />
              <polygon points="120,430 780,430 700,540 200,540" fill="url(#circuit-pattern)" opacity="0.6" />
              <polygon points="120,430 780,430 700,540 200,540" fill="url(#floor-glow-grad)" opacity="0.5" />
              <!-- Bordes luminosos -->
              <line x1="120" y1="430" x2="200" y2="540" stroke="#00b9f2" stroke-width="2" filter="url(#neon-glow)" opacity="0.8" />
              <line x1="780" y1="430" x2="700" y2="540" stroke="#00b9f2" stroke-width="2" filter="url(#neon-glow)" opacity="0.8" />
              <line x1="120" y1="430" x2="780" y2="430" stroke="#188ef3" stroke-width="2" filter="url(#neon-glow)" opacity="0.6" />
              <text x="720" y="525" fill="rgba(255,255,255,0.15)" font-family="JetBrains Mono, monospace" font-size="11" text-anchor="end" letter-spacing="0.08em">3,00 × 3,00 m</text>
            </g>

            <!-- Reflejo de la estructura en el suelo -->
            <g opacity="0.15" filter="url(#reflection-blur)" transform="scale(1, -1) translate(0, -970)">
              <polygon points="220,430 320,120 360,120 260,430" fill="#03246f" />
              <polygon points="540,430 640,120 680,120 580,430" fill="#03246f" />
            </g>

            <!-- Sombras proyectadas -->
            <ellipse cx="320" cy="500" rx="70" ry="12" fill="rgba(0,0,0,0.45)" filter="url(#reflection-blur)" />
            <ellipse cx="580" cy="500" rx="70" ry="12" fill="rgba(0,0,0,0.45)" filter="url(#reflection-blur)" />
            <ellipse cx="450" cy="510" rx="90" ry="16" fill="rgba(0,0,0,0.5)" filter="url(#reflection-blur)" />
            <ellipse cx="230" cy="520" rx="45" ry="8" fill="rgba(0,0,0,0.4)" filter="url(#reflection-blur)" />

            <!-- Torre izquierda inclinada hacia el centro -->
            <g filter="url(#shadow-soft)">
              <!-- Estructura trasera -->
              <polygon points="220,470 320,100 380,100 280,470" fill="url(#tower-grad)" stroke="rgba(24,142,243,0.3)" stroke-width="1" />
              <polygon points="220,470 320,100 380,100 280,470" fill="url(#truss-pattern)" opacity="0.4" />
              <!-- Marco metálico -->
              <polygon points="225,470 315,110 375,110 285,470" fill="none" stroke="#00b9f2" stroke-width="2" filter="url(#neon-glow)" opacity="0.7" />
              <!-- Pantalla LED curva -->
              <path d="M 240 430 L 315 130 Q 335 125 355 130 L 300 430 Z" fill="#0a0f16" stroke="#188ef3" stroke-width="1" />
              <image href={img('servicio-tableros.jpg')} x="235" y="130" width="130" height="310" clip-path="url(#screen-clip-1)" preserveAspectRatio="xMidYMid slice" opacity="0.85" />
              <!-- Brillo de pantalla -->
              <path d="M 240 430 L 315 130 Q 335 125 355 130 L 300 430 Z" fill="url(#floor-glow-grad)" opacity="0.3" />
              <!-- Tira LED lateral -->
              <line x1="315" y1="110" x2="375" y2="110" stroke="#00b9f2" stroke-width="3" filter="url(#neon-glow)" />
              <!-- Detalle truss -->
              <line x1="250" y1="400" x2="335" y2="180" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
              <line x1="270" y1="400" x2="350" y2="180" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
            </g>

            <!-- Torre derecha inclinada hacia el centro -->
            <g filter="url(#shadow-soft)">
              <polygon points="620,470 520,100 580,100 680,470" fill="url(#tower-grad)" stroke="rgba(24,142,243,0.3)" stroke-width="1" />
              <polygon points="620,470 520,100 580,100 680,470" fill="url(#truss-pattern)" opacity="0.4" />
              <polygon points="525,470 525,110 585,110 675,470" fill="none" stroke="#00b9f2" stroke-width="2" filter="url(#neon-glow)" opacity="0.7" />
              <!-- Pantalla LED curva -->
              <path d="M 600 430 L 545 130 Q 565 125 585 130 L 660 430 Z" fill="#0a0f16" stroke="#188ef3" stroke-width="1" />
              <image href={img('proyecto-posco.jpg')} x="540" y="130" width="130" height="310" clip-path="url(#screen-clip-2)" preserveAspectRatio="xMidYMid slice" opacity="0.85" />
              <path d="M 600 430 L 545 130 Q 565 125 585 130 L 660 430 Z" fill="url(#floor-glow-grad)" opacity="0.3" />
              <line x1="525" y1="110" x2="585" y2="110" stroke="#00b9f2" stroke-width="3" filter="url(#neon-glow)" />
              <line x1="550" y1="400" x2="565" y2="180" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
              <line x1="570" y1="400" x2="585" y2="180" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
            </g>

            <!-- Arco superior metálico -->
            <g filter="url(#shadow-soft)">
              <!-- Viga principal -->
              <polygon points="320,100 580,100 590,140 330,140" fill="url(#metal-grad)" stroke="rgba(24,142,243,0.4)" stroke-width="1" />
              <polygon points="330,140 590,140 590,155 330,155" fill="#0f1620" stroke="rgba(0,185,242,0.3)" stroke-width="1" />
              <!-- Tira LED superior -->
              <line x1="325" y1="105" x2="575" y2="105" stroke="#00b9f2" stroke-width="4" filter="url(#neon-glow)" />
              <!-- Luces colgantes del arco -->
              <line x1="370" y1="140" x2="370" y2="180" stroke="rgba(255,255,255,0.3)" stroke-width="1" />
              <line x1="450" y1="140" x2="450" y2="170" stroke="rgba(255,255,255,0.3)" stroke-width="1" />
              <line x1="530" y1="140" x2="530" y2="180" stroke="rgba(255,255,255,0.3)" stroke-width="1" />
              <circle cx="370" cy="185" r="6" fill="#fff" filter="url(#neon-glow)" />
              <circle cx="450" cy="175" r="7" fill="#fff" filter="url(#neon-glow)" />
              <circle cx="530" cy="185" r="6" fill="#fff" filter="url(#neon-glow)" />
              <!-- Haces de luz -->
              <polygon points="370,185 350,500 390,500" fill="rgba(255,255,255,0.04)" />
              <polygon points="450,175 420,500 480,500" fill="rgba(255,255,255,0.05)" />
              <polygon points="530,185 510,500 550,500" fill="rgba(255,255,255,0.04)" />
            </g>

            <!-- Cubo central flotante con logo -->
            <g class="float-anim" style="transform-origin: 450px 170px;">
              <!-- Cara trasera -->
              <polygon points="410,150 490,150 490,230 410,230" fill="#03246f" stroke="rgba(0,185,242,0.3)" stroke-width="1" />
              <!-- Cara lateral derecha -->
              <polygon points="490,150 510,140 510,220 490,230" fill="#0a3b66" stroke="rgba(0,185,242,0.2)" stroke-width="1" />
              <!-- Cara superior -->
              <polygon points="410,150 490,150 510,140 430,140" fill="#188ef3" opacity="0.6" />
              <!-- Cara frontal -->
              <polygon points="400,160 480,160 480,240 400,240" fill="url(#tower-grad)" stroke="rgba(0,185,242,0.5)" stroke-width="2" filter="url(#neon-glow)" />
              <!-- Logo -->
              <image href={img('logo-pyp-white.png')} x="405" y="165" width="70" height="70" preserveAspectRatio="xMidYMid meet" />
              <!-- Glow del cubo -->
              <circle cx="440" cy="200" r="60" fill="rgba(0,185,242,0.15)" filter="url(#neon-glow)" />
            </g>

            <!-- Mostrador-isla angular -->
            <g filter="url(#shadow-soft)">
              <!-- Base/sombra -->
              <polygon points="360,500 540,500 560,540 380,540" fill="#0a0f16" />
              <!-- Cuerpo mostrador -->
              <polygon points="360,440 540,440 540,500 360,500" fill="url(#counter-grad)" stroke="rgba(24,142,243,0.4)" stroke-width="1" />
              <!-- Tapa -->
              <polygon points="350,430 550,430 540,440 360,440" fill="url(#metal-grad)" stroke="rgba(0,185,242,0.3)" stroke-width="1" />
              <!-- Lado frontal con iluminación -->
              <polygon points="350,430 550,430 540,440 360,440" fill="url(#floor-glow-grad)" opacity="0.4" />
              <!-- Logo frontal -->
              <image href={img('logo-pyp-white.png')} x="390" y="450" width="120" height="40" preserveAspectRatio="xMidYMid meet" />
              <!-- Línea LED frontal -->
              <line x1="360" y1="490" x2="540" y2="490" stroke="#00b9f2" stroke-width="2" filter="url(#neon-glow)" />
            </g>

            <!-- Exhibidor hexagonal -->
            <g transform="translate(180, 360)" filter="url(#shadow-soft)">
              <!-- Hexágono base -->
              <polygon points="0,60 35,0 105,0 140,60 105,120 35,120" fill="#0f1620" stroke="rgba(24,142,243,0.4)" stroke-width="1" />
              <!-- Niveles hexagonales -->
              <polygon points="10,55 40,5 100,5 130,55 100,105 40,105" fill="#1a2330" stroke="rgba(0,185,242,0.25)" stroke-width="1" />
              <polygon points="20,50 45,10 95,10 120,50 95,90 45,90" fill="#0a0f16" stroke="rgba(0,185,242,0.2)" stroke-width="1" />
              <!-- Productos representados -->
              <rect x="40" y="20" width="25" height="25" fill="#273344" stroke="rgba(0,185,242,0.3)" />
              <rect x="75" y="20" width="25" height="25" fill="#36475c" stroke="rgba(0,185,242,0.3)" />
              <rect x="58" y="52" width="25" height="25" fill="#188ef3" opacity="0.5" stroke="rgba(0,185,242,0.4)" />
              <!-- Luz superior -->
              <circle cx="70" cy="0" r="4" fill="#00b9f2" filter="url(#neon-glow)" />
            </g>

            <!-- Pantalla curva fondo -->
            <g filter="url(#shadow-soft)">
              <path d="M 320 100 Q 450 80 580 100 L 580 180 Q 450 160 320 180 Z" fill="#0a0f16" stroke="rgba(0,185,242,0.4)" stroke-width="2" />
              <image href={img('hero-tableros.jpg')} x="280" y="60" width="340" height="150" preserveAspectRatio="xMidYMid slice" opacity="0.5" />
              <!-- No usamos clip-path con medidas px por compatibilidad; en su lugar overlay -->
              <path d="M 320 100 Q 450 80 580 100 L 580 180 Q 450 160 320 180 Z" fill="url(#tower-grad)" opacity="0.4" />
              <text x="450" y="145" text-anchor="middle" fill="#fff" font-family="Space Grotesk, sans-serif" font-size="16" font-weight="700">PyP Electricidad</text>
              <text x="450" y="163" text-anchor="middle" fill="#00b9f2" font-family="JetBrains Mono, monospace" font-size="8" letter-spacing="0.1em">MATERIALES · SOLUCIONES · PROYECTOS</text>
            </g>

            <!-- Spots del techo -->
            <g>
              <circle cx="250" cy="40" r="12" fill="#fff" filter="url(#neon-glow)" />
              <circle cx="450" cy="25" r="14" fill="#fff" filter="url(#neon-glow)" />
              <circle cx="650" cy="40" r="12" fill="#fff" filter="url(#neon-glow)" />
              <!-- Haces -->
              <polygon points="250,40 210,500 290,500" fill="rgba(255,255,255,0.03)" filter="url(#light-beam)" />
              <polygon points="450,25 390,500 510,500" fill="rgba(255,255,255,0.04)" filter="url(#light-beam)" />
              <polygon points="650,40 610,500 690,500" fill="rgba(255,255,255,0.03)" filter="url(#light-beam)" />
            </g>

            <!-- Textos flotantes / señalética -->
            <g>
              <text x="120" y="350" fill="rgba(0,185,242,0.6)" font-family="JetBrains Mono, monospace" font-size="8" letter-spacing="0.15em" transform="rotate(-90 120 350)">ENERGÍA · INDUSTRIA · MINERÍA</text>
              <text x="780" y="350" fill="rgba(0,185,242,0.6)" font-family="JetBrains Mono, monospace" font-size="8" letter-spacing="0.15em" transform="rotate(90 780 350)">ISO 9001 · 14001 · 45001</text>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <!-- Vistas técnicas -->
    <section class="relative border-t border-steel-700 bg-steel-800 py-16">
      <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-10"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">Vistas técnicas</span>
        </div>
        <h3 class="font-display text-3xl font-bold text-white mb-10">Elevaciones y planta · Portal Energético</h3>

        <div class="grid gap-6 md:grid-cols-3">
          <!-- Vista frontal -->
          <div class="tech-view rounded-lg border border-steel-600 bg-steel-900 p-4">
            <div class="font-mono text-xs uppercase tracking-wider text-brand-light mb-3">Frente · 3,00 m</div>
            <div class="tech-canvas front-view">
              <div class="tv-wall">
                <img src={img('logo-pyp-white.png')} alt="PyP" class="tv-logo" />
                <div class="tv-line"></div>
