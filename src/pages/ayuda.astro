---
import PageLayout from '../layouts/PageLayout.astro';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const img = (name) => `${base}images/${name}`;

const compromisos = [
  {
    title: 'Compromiso con la mejora continua',
    text: 'Nos comprometemos a mejorar continuamente nuestro sistema de gestión integrado, enfocándonos en la satisfacción del cliente, la seguridad, la salud en el trabajo, la protección del medio ambiente y la prevención de la contaminación.',
  },
  {
    title: 'Cumplimiento legal y reglamentario',
    text: 'Garantizamos el cumplimiento de todos los requisitos legales y reglamentarios aplicables a nuestras actividades, productos y servicios, así como los relacionados con la protección del medio ambiente y la prevención de la contaminación.',
  },
  {
    title: 'Satisfacción del cliente',
    text: 'Entendemos las necesidades de nuestros clientes y nos esforzamos por satisfacer sus expectativas, brindando productos y servicios que cumplan con los más altos estándares de calidad, seguridad, respeto al medio ambiente y prevención de la contaminación.',
  },
  {
    title: 'Ambiente laboral positivo y seguro',
    text: 'Promovemos un ambiente laboral positivo y participativo, donde cada empleado se sienta valorado y seguro. Proporcionamos condiciones de trabajo seguras y saludables, minimizando los impactos ambientales de nuestras operaciones.',
  },
  {
    title: 'Prevención de accidentes e incidentes',
    text: 'Investigamos activamente los accidentes e incidentes para evitar su repetición y realizamos capacitaciones periódicas para prevenir emergencias y mantener un entorno laboral seguro. Además, promovemos la identificación y eliminación de peligros y la reducción de riesgos en todas las operaciones de la empresa, considerando también su impacto en el medio ambiente y la prevención de la contaminación.',
  },
  {
    title: 'Participación y consulta',
    text: 'Valoramos la participación y consulta de nuestros colaboradores y sus representantes gremiales en todas las cuestiones relacionadas con la seguridad, salud en el trabajo, el medio ambiente y la prevención de la contaminación, aplicando las mejores prácticas de seguridad y fomentando la conciencia ambiental en todas nuestras actividades.',
  },
];

const otrasPoliticas = [
  'Políticas de privacidad',
  'Políticas de uso',
  'Declaración de accesibilidad',
  'Políticas de envío',
  'Política de devoluciones',
];
---

<PageLayout
  pageTitle="Ayuda"
  pageSubtitle="Políticas y declaraciones de PyP Electricidad S.R.L."
>
  <!-- ============ POLÍTICA DE GESTIÓN INTEGRADA ============ -->
  <section class="relative bg-steel-900 py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-16 max-w-3xl">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">01 / Gestión integrada</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
          Políticas de <span class="text-brand">gestión integrada</span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-400">
          La Dirección de P&P Electricidad establece la siguiente política integrada de calidad,
          seguridad y salud en el trabajo, y medio ambiente, con el fin de asegurar el cumplimiento
          de los requisitos de las normas ISO 9001, ISO 45001 e ISO 14001:
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {compromisos.map((c, i) => (
          <div class="industrial-corner flex items-start gap-4 border border-steel-600 bg-steel-800 p-6 transition-all hover:border-brand/50">
            <span class="mt-1 font-mono text-sm font-bold text-brand-light">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="mb-1 font-display text-base font-bold text-white">{c.title}</h3>
              <p class="text-sm leading-relaxed text-slate-300">{c.text}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Nota al pie -->
      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-steel-600 pt-6">
        <p class="font-mono text-xs uppercase tracking-wider text-slate-500">
          PO CA 01 - Rv03 — Vigencia 14/02/2024
        </p>
        <a href={`${base}docs/politica-gestion-integrada.pdf`} target="_blank" rel="noopener" class="font-mono text-xs uppercase tracking-wider text-brand-light underline-offset-4 transition-colors hover:text-white hover:underline">
          Descargar política completa (PDF) ↗
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CERTIFICACIONES ============ -->
  <section class="relative bg-steel-800 py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-16 max-w-3xl">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">02 / Certificaciones</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
          Sistemas <span class="text-brand">certificados</span>
        </h2>
      </div>

      <div class="grid items-center gap-12 md:grid-cols-2">
        <div class="industrial-corner overflow-hidden border border-steel-600 bg-steel-900">
          <img src={img('certificados-iso.jpg')} alt="Certificados ISO 9001, ISO 14001 e ISO 45001 de PyP Electricidad emitidos por Bureau Veritas" class="h-full w-full object-cover" />
        </div>
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span class="h-px w-12 bg-brand-light"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">Bureau Veritas Certification</span>
          </div>
          <p class="text-lg leading-relaxed text-slate-300">
            Nuestros sistemas están certificados según
            <span class="font-bold text-white">ISO:9001</span>,
            <span class="font-bold text-white">ISO:14001</span> e
            <span class="font-bold text-white">ISO:45001</span> por Bureau Veritas Certification.
          </p>
          <div class="mt-8 grid grid-cols-3 gap-4 border-t border-steel-600 pt-8">
            <div>
              <div class="font-display text-2xl font-bold text-brand">9001</div>
              <div class="mt-1 font-mono text-xs uppercase tracking-wider text-slate-500">Calidad</div>
            </div>
            <div>
              <div class="font-display text-2xl font-bold text-brand">14001</div>
              <div class="mt-1 font-mono text-xs uppercase tracking-wider text-slate-500">Ambiental</div>
            </div>
            <div>
              <div class="font-display text-2xl font-bold text-brand">45001</div>
              <div class="mt-1 font-mono text-xs uppercase tracking-wider text-slate-500">Seguridad</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OTRAS POLÍTICAS ============ -->
  <section class="relative bg-steel-900 py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-16 max-w-3xl">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">03 / Documentación</span>
        </div>
        <h2 class="font-display text-4xl font-bold text-white md:text-5xl">
          Otras <span class="text-brand">políticas</span>
        </h2>
        <p class="mt-6 text-lg text-slate-400">
          Documentos y declaraciones institucionales disponibles para consulta.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {otrasPoliticas.map((p) => (
          <div class="industrial-corner group flex items-center justify-between border border-steel-600 bg-steel-800 p-6 transition-all hover:border-brand">
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 items-center justify-center border border-brand/30 bg-brand/10">
                <svg class="h-5 w-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <span class="font-display text-base font-bold text-white">{p}</span>
            </div>
            <span class="font-mono text-sm text-slate-500 transition-transform group-hover:translate-x-1 group-hover:text-brand-light">→</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
