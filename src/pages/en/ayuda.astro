---
import PageLayout from '../../layouts/PageLayout.astro';

const rawBase = import.meta.env.BASE_URL ?? '/';
const rawBaseClean = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const base = `${rawBaseClean}en/`;
const img = (name) => `${rawBaseClean}images/${name}`;
---

<PageLayout
  locale="en"
  pageTitle="Help"
  pageSubtitle="Policies and statements of PyP Electricidad S.R.L."
>
  <!-- Section: Integrated Management Policy -->
  <section class="bg-steel-900 py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl text-brand-light uppercase tracking-wide mb-8 border-b-2 border-brand pb-2">
        Integrated Management Policy
      </h2>
      <div class="space-y-6 text-steel-100 leading-relaxed">
        <p>
          The management of P&P Electricidad establishes the following integrated policy of quality, occupational health and safety, and environment, in order to ensure compliance with the requirements of ISO 9001, ISO 45001 and ISO 14001 standards:
        </p>
        <ul class="space-y-4 pl-6 list-disc marker:text-brand">
          <li>
            <strong class="text-white">Commitment to continuous improvement:</strong> We are committed to continuously improving our integrated management system, focusing on customer satisfaction, safety, occupational health, environmental protection and pollution prevention.
          </li>
          <li>
            <strong class="text-white">Legal and regulatory compliance:</strong> We guarantee compliance with all legal and regulatory requirements applicable to our activities, products and services, as well as those related to environmental protection and pollution prevention.
          </li>
          <li>
            <strong class="text-white">Customer satisfaction:</strong> We understand our clients' needs and strive to meet their expectations, providing products and services that meet the highest standards of quality, safety, environmental respect and pollution prevention.
          </li>
          <li>
            <strong class="text-white">Positive and safe work environment:</strong> We promote a positive and participatory work environment where every employee feels valued and safe. We provide safe and healthy working conditions, minimizing the environmental impact of our operations.
          </li>
          <li>
            <strong class="text-white">Accident and incident prevention:</strong> We actively investigate accidents and incidents to prevent their recurrence and conduct periodic training to prevent emergencies and maintain a safe work environment. In addition, we promote the identification and elimination of hazards and the reduction of risks in all company operations, also considering their impact on the environment and pollution prevention.
          </li>
          <li>
            <strong class="text-white">Participation and consultation:</strong> We value the participation and consultation of our collaborators and their union representatives in all matters related to safety, occupational health, the environment and pollution prevention, applying best safety practices and fostering environmental awareness in all our activities.
          </li>
        </ul>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-steel-600">
          <p class="font-mono text-sm text-slate-400">
            PO CA 01 - Rv03 — Valid from 14/02/2024
          </p>
          <a href={`${rawBaseClean}docs/politica-gestion-integrada.pdf`} target="_blank" rel="noopener" class="font-mono text-xs uppercase tracking-wider text-brand-light underline-offset-4 transition-colors hover:text-white hover:underline">
            Download full policy (PDF) ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Certifications -->
  <section class="bg-steel-800 py-16 px-4">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl text-brand-light uppercase tracking-wide mb-8 border-b-2 border-brand pb-2 inline-block">
        Certifications
      </h2>
      <div class="flex flex-col items-center gap-6">
        <div class="industrial-corner overflow-hidden rounded-lg border border-steel-700 bg-steel-800">
          <img src={img('certificados-iso.jpg')} alt="ISO 9001, ISO 14001 and ISO 45001 certificates issued to PyP Electricidad by Bureau Veritas" class="h-auto w-full max-w-3xl object-cover" />
        </div>
        <p class="font-mono text-steel-100 leading-relaxed max-w-3xl">
          Our systems are certified according to ISO:9001, ISO:14001 and ISO:45001 by Bureau Veritas Certification.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Other Policies -->
  <section class="bg-steel-900 py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl text-brand-light uppercase tracking-wide mb-8 border-b-2 border-brand pb-2">
        Other Policies
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="border border-steel-600 hover:border-brand transition-colors duration-300 bg-steel-800 p-6">
          <h3 class="font-display text-lg text-brand-light uppercase tracking-wide mb-2">
            Privacy Policy
          </h3>
          <p class="text-steel-100 text-sm leading-relaxed">
            Information on how we collect, use and protect personal data.
          </p>
        </div>
        <div class="border border-steel-600 hover:border-brand transition-colors duration-300 bg-steel-800 p-6">
          <h3 class="font-display text-lg text-brand-light uppercase tracking-wide mb-2">
            Terms of Use
          </h3>
          <p class="text-steel-100 text-sm leading-relaxed">
            Conditions governing the use of our website and services.
          </p>
        </div>
        <div class="border border-steel-600 hover:border-brand transition-colors duration-300 bg-steel-800 p-6">
          <h3 class="font-display text-lg text-brand-light uppercase tracking-wide mb-2">
            Accessibility Statement
          </h3>
          <p class="text-steel-100 text-sm leading-relaxed">
            Our commitment to accessibility for all users.
          </p>
        </div>
        <div class="border border-steel-600 hover:border-brand transition-colors duration-300 bg-steel-800 p-6">
          <h3 class="font-display text-lg text-brand-light uppercase tracking-wide mb-2">
            Shipping Policy
          </h3>
          <p class="text-steel-100 text-sm leading-relaxed">
            Details on shipping methods, times and coverage areas.
          </p>
        </div>
        <div class="border border-steel-600 hover:border-brand transition-colors duration-300 bg-steel-800 p-6">
          <h3 class="font-display text-lg text-brand-light uppercase tracking-wide mb-2">
            Returns Policy
          </h3>
          <p class="text-steel-100 text-sm leading-relaxed">
            Conditions and procedures for returns and exchanges.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
