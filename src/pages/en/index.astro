<script is:inline>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('contact-submit');
    const status = document.getElementById('contact-status');

    const payload = {
      _subject: `Website inquiry: ${form.nombre.value}`,
      _template: 'table',
      _captcha: 'false',
      _honey: form._honey.value,
      Name: form.nombre.value,
      Email: form.email.value,
      Message: form.mensaje.value,
    };

    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.classList.add('hidden');

    try {
      const res = await fetch('https://formsubmit.co/ajax/ventas@pyp-argentina.com.ar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || data.success !== 'true') throw new Error(data.message || 'HTTP ' + res.status);
      status.textContent = '✓ Inquiry sent. We will reply shortly.';
      status.className = 'text-center text-sm text-emerald-400';
      form.reset();
    } catch {
      status.textContent = 'Could not send. Please email ventas@pyp-argentina.com.ar';
      status.className = 'text-center text-sm text-red-400';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send inquiry →';
    }
  });
</script>
