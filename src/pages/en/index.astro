---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const rawBase = import.meta.env.BASE_URL ?? '/';
const rawBaseClean = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const base = `${rawBaseClean}en/`;
const img = (name) => `${rawBaseClean}images/${name}`;

const provision = [
  'Electrical materials',
  'Lighting',
  'Specialized supplies and components',
  'Standardized electrical products',
];

const solutions = [
  'Electrical panel integration',
  'Automation and control',
  'Electromechanical services',
  'Electrical maintenance',
  'Medium and large-scale installations',
];

const process = [
  { num: '01', label: 'Need', desc: 'We identify the client requirement.' },
  { num: '02', label: 'Selection', desc: 'We choose the right materials.' },
  { num: '03', label: 'Technical Solution', desc: 'We design a tailored solution.' },
  { num: '04', label: 'Supply', desc: 'We provide the components.' },
  { num: '05', label: 'Execution', desc: 'Project commissioning.' },
  { num: '06', label: 'Maintenance', desc: 'Continuous scheduled maintenance.' },
];

const sectors = [
  { name: 'Industry', icon: 'factory' },
  { name: 'Mining', icon: 'mine' },
  { name: 'Energy', icon: 'energy' },
  { name: 'Construction', icon: 'construction' },
  { name: 'Industrial Plants', icon: 'plant' },
  { name: 'Engineering', icon: 'engineering' },
  { name: 'Maintenance', icon: 'maintenance' },
];

const traits = [
  { name: 'Technical', desc: 'We know the products and the needs behind every project.' },
  { name: 'Industrial', desc: 'Our experience and clients go beyond retail.' },
  { name: 'Approachable', desc: 'We maintain an accessible, human relationship with all clients.' },
  { name: 'Reliable', desc: 'We demonstrate experience, products, service and quality processes.' },
];

const backing = [
  'Industry experience',
  'Technical knowledge',
  'Industrial project work',
  'Large-scale works and plants',
  'Relationships with leading brands and suppliers',
  'Experience in demanding environments',
  'Regional and local coverage (NOA)',
  'ISO 9001, ISO 14001 and ISO 45001 certifications',
];

const services = [
  {
    num: '01',
    title: 'Panel Integration',
    desc: 'We design solutions that optimize performance and ensure a constant electrical flow.',
    image: 'servicio-tableros.jpg',
  },
  {
    num: '02',
    title: 'Industrial Automation',
    desc: 'Solutions that increase efficiency, reduce costs and guarantee precision and operational continuity.',
    image: 'servicio-automatismo.jpg',
  },
  {
    num: '03',
    title: 'Electromechanical Works',
    desc: 'An integral approach that guarantees efficiency and safety in every project.',
    image: 'servicio-obras.jpg',
  },
];

const partners = ['ABB', 'BAEL', 'Delga', 'LCT', 'Rockwell', 'Gevelux', 'Zoloda', 'Tecnocom', 'San Justo'];

const igPosts = [
  { shortcode: 'Dcyna5TFmgQ', date: '02 Sep 2026', isVideo: false, caption: 'A new branch, a new electrical installation. Thanks to Felfit for trusting PyP Electricidad for the opening of their new branch in downtown Tucumán.' },
  { shortcode: 'DclsIhFlhgt', date: '28 Aug 2026', isVideo: false, caption: 'Some things cannot be resolved by looking at a blueprint. Before quoting, before choosing materials and before starting to install... you need to know the site.' },
  { shortcode: 'DcToW4RlvW8', date: '21 Aug 2026', isVideo: false, caption: 'Site visit: the project starts before installation.' },
  { shortcode: 'Db_en1mMdzt', date: '13 Aug 2026', isVideo: true, caption: 'Electrical safety news: aerosol extinguishing device.' },
  { shortcode: 'Db8SPJMlqEy', date: '12 Aug 2026', isVideo: false, caption: 'August, month of the Pachamama. Caring for the environment is part of our responsibility. ISO 14001 | Environmental management.' },
  { shortcode: 'DboE6kOxwtg', date: '04 Aug 2026', isVideo: false, caption: 'Cable tray replacement with reliable base.' },
  { shortcode: 'Dbdo_AwFurA', date: '31 Jul 2026', isVideo: false, caption: 'UPS maintenance at Supercanal Tucumán. A failure at runtime means a high cost.' },
  { shortcode: 'DbToEQzFuBM', date: '27 Jul 2026', isVideo: false, caption: 'Work safely with PyP Electricidad. PPE (Personal Protective Equipment) line.' },
  { shortcode: 'DbA8Dv_ljqg', date: '20 Jul 2026', isVideo: false, caption: 'Work performed at industrial plant.' },
  { shortcode: 'Dauwocpljy1', date: '10 Jul 2026', isVideo: false, caption: 'Electrician making adjustments on an industrial electrical panel.' },
];

const productCategories = [
  { name: 'Lighting', image: 'producto-panel-led.jpg', family: 'iluminacion' },
  { name: 'Protection', image: 'producto-termomagnetica.jpg', family: 'proteccion-distribucion' },
  { name: 'Automation', image: 'producto-contactores.jpg', family: 'automatizacion-control' },
  { name: 'Conductors', image: 'producto-cables.jpg', family: 'conductores-conexion' },
  { name: 'Cable Management', image: 'producto-bandeja.jpg', family: 'canalizacion' },
  { name: 'Grounding', image: 'producto-jabalina.jpg', family: 'puesta-a-tierra' },
  { name: 'Emergency', image: 'producto-luz-emergencia.jpg', family: 'iluminacion' },
  { name: 'Enclosures', image: 'producto-transformador.jpg', family: 'gabinetes-tableros' },
  { name: 'Explosion-Proof', image: 'producto-interruptores.jpg', family: 'antiexplosivos' },
];
---

<BaseLayout title="PyP Electricidad S.R.L. — Electrical Materials & Solutions" description="Electrical materials, electromechanical works and panel integration. Tucumán-based company with over 15 years of experience.">
  <Header locale="en" />

  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-screen items-center overflow-hidden bg-steel-900 pt-20">
    <div class="absolute inset-0">
      <img src={img('hero-tableros.jpg')} alt="Industrial electrical panels" class="h-full w-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-r from-steel-900 via-steel-900/85 to-steel-900/40"></div>
    </div>

    <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-30"></div>
    <div class="absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-brand/20 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 border border-brand/30 bg-steel-800/50 px-3 py-1.5 md:mb-6 md:px-4 md:py-2">
            <span class="h-2 w-2 animate-pulse-slow bg-brand-light"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-brand-light md:text-xs md:tracking-[0.25em]">San Miguel de Tucumán · NOA · Argentina</span>
          </div>

          <h1 class="font-display text-4xl font-bold leading-[0.95] text-white sm:text-5xl md:text-7xl">
            Connecting
            <span class="block text-brand">energy</span>
            <span class="block text-brand-light">and quality</span>
          </h1>

          <p class="mt-6 max-w-lg text-base leading-relaxed text-slate-300 md:mt-8 md:text-lg">
            An <span class="font-bold text-white">integral</span> electrical company: supply of materials
            and electromechanical solutions for industry, mining, energy and construction.
            Over <span class="font-bold text-brand-light">15 years</span> of technical experience.
          </p>

          <div class="mt-8 flex flex-wrap gap-3 md:mt-10 md:gap-4">
            <a
              href={`${base}#contacto`}
              class="group relative bg-brand px-6 py-3 font-display text-xs font-bold uppercase tracking-wider text-white transition-all hover:bg-brand-light md:px-8 md:py-4 md:text-sm"
            >
              Request a Quote
              <span class="ml-2 inline-block transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a
              href={`${base}servicios`}
              class="border border-brand/40 px-6 py-3 font-display text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-brand hover:bg-brand/10 md:px-8 md:py-4 md:text-sm"
            >
              View Solutions
            </a>
          </div>

          <div class="mt-10 grid grid-cols-3 gap-4 border-t border-steel-700 pt-6 md:mt-14 md:gap-6 md:pt-8">
            <div>
              <div class="font-display text-2xl font-bold text-brand md:text-3xl">15+</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-slate-500 md:text-xs">Years</div>
            </div>
            <div>
              <div class="font-display text-2xl font-bold text-brand md:text-3xl">3</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-slate-500 md:text-xs">ISO</div>
            </div>
            <div>
              <div class="font-display text-2xl font-bold text-brand md:text-3xl">NOA</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-slate-500 md:text-xs">Coverage</div>
            </div>
          </div>
        </div>

        <div class="relative hidden lg:block">
          <div class="industrial-corner relative aspect-square overflow-hidden border border-brand/20 bg-steel-800">
            <img src={img('frente-local.jpg')} alt="PyP Electricidad headquarters" class="h-full w-full object-cover opacity-80" />
            <div class="absolute inset-0 bg-gradient-to-t from-steel-900 via-transparent to-transparent"></div>
            <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>
            <div class="absolute left-4 top-4 font-mono text-xs text-brand-light/80">PyP_HEADQUARTERS</div>
            <div class="absolute bottom-4 right-4 font-mono text-xs text-brand-light/80">Tucumán · AR</div>
          </div>
          <div class="absolute -bottom-4 -left-4 bg-brand-light px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-white">
            ● Active system
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <div class="flex flex-col items-center gap-2">
        <span class="font-mono text-xs uppercase tracking-widest text-slate-500">Scroll</span>
        <div class="h-12 w-px bg-gradient-to-b from-brand to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT IS PyP ============ -->
  <section class="relative bg-steel-800 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 max-w-3xl md:mb-16">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">01 / What we are</span>
        </div>
        <h2 class="font-display text-3xl font-bold text-white md:text-5xl">
          We don't just sell. <span class="text-brand">We solve.</span>
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-400 md:mt-6 md:text-lg">
          PyP Electricidad is a company specialized in the commercialization of electrical materials
          and the development of electrical and electromechanical solutions, oriented towards industry
          and technically demanding projects. We are not a hardware store: we are an integral electrical company.
        </p>
      </div>

      <div class="grid gap-4 md:gap-6 md:grid-cols-2">
        <div class="industrial-corner border border-steel-600 bg-steel-900 p-6 md:p-8">
          <div class="mb-4 flex items-center gap-3 md:mb-6 md:gap-4">
            <div class="flex h-10 w-10 items-center justify-center border border-brand/30 bg-brand/10 md:h-12 md:w-12">
              <svg class="h-5 w-5 text-brand md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7h18M3 12h18M3 17h18M7 7v10M17 7v10" /></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white md:text-2xl">Supply</h3>
          </div>
          <ul class="space-y-2 md:space-y-3">
            {provision.map((p) => (
              <li class="flex items-start gap-3 text-sm text-slate-300 md:text-base">
                <span class="mt-1 text-brand">▸</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="industrial-corner border border-brand-light/30 bg-steel-900 p-6 md:p-8">
          <div class="mb-4 flex items-center gap-3 md:mb-6 md:gap-4">
            <div class="flex h-10 w-10 items-center justify-center border border-brand-light/30 bg-brand-light/10 md:h-12 md:w-12">
              <svg class="h-5 w-5 text-brand-light md:h-6 md:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white md:text-2xl">Solutions</h3>
          </div>
          <ul class="space-y-2 md:space-y-3">
            {solutions.map((s) => (
              <li class="flex items-start gap-3 text-sm text-slate-300 md:text-base">
                <span class="mt-1 text-brand-light">▸</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="relative overflow-hidden bg-steel-900 py-16 md:py-24">
    <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 max-w-3xl md:mb-16">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">02 / How we work</span>
        </div>
        <h2 class="font-display text-3xl font-bold text-white md:text-5xl">
          From start <span class="text-brand">to finish</span>
        </h2>
        <p class="mt-4 text-base text-slate-400 md:mt-6 md:text-lg">
          We don't limit ourselves to selling a component. We participate in every stage of an electrical need.
          This ability to solve from start to finish is what sets us apart from a traditional store.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-4">
        {process.map((step, i) => (
          <div class="group relative border border-steel-600 bg-steel-800 p-4 transition-all hover:border-brand/50 md:p-5">
            <div class="font-mono text-xs text-brand-light/60">{step.num}</div>
            <div class="mt-2 font-display text-sm font-bold text-white md:text-base">{step.label}</div>
            <p class="mt-1 text-xs leading-relaxed text-slate-400 md:mt-2">{step.desc}</p>
            {i < process.length - 1 && (
              <div class="absolute -right-2 top-1/2 hidden h-4 w-4 -translate-y-1/2 items-center justify-center text-brand md:flex">
                →
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="servicios" class="relative bg-steel-800 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 flex flex-col items-start gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-3 flex items-center gap-3">
            <span class="h-px w-12 bg-brand-light"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">03 / Services</span>
          </div>
          <h2 class="font-display text-3xl font-bold text-white md:text-5xl">
            What we <span class="text-brand">do</span>
          </h2>
        </div>
        <p class="max-w-md text-sm text-slate-400 md:text-base">
          Comprehensive solutions for the electrical industry in the NOA region. From engineering to installation.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
        {services.map((s) => (
          <article class="industrial-corner group relative overflow-hidden border border-steel-600 bg-steel-900 transition-all hover:border-brand/50">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img src={img(s.image)} alt={s.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-steel-900 via-steel-900/40 to-transparent"></div>
              <span class="absolute right-4 top-4 font-display text-5xl font-bold text-steel-700/60 transition-colors group-hover:text-brand/30">{s.num}</span>
            </div>
            <div class="p-5 md:p-6">
              <h3 class="mb-2 font-display text-lg font-bold text-white md:text-xl">{s.title}</h3>
              <p class="text-sm leading-relaxed text-slate-400">{s.desc}</p>
              <a href={`${base}servicios`} class="mt-4 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-brand-light transition-colors hover:text-brand-light">
                Learn more <span>→</span>
              </a>
            </div>
            <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-brand-light transition-all duration-500 group-hover:w-full"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SECTORS ============ -->
  <section class="relative bg-steel-900 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-12 max-w-3xl md:mb-16">
        <div class="mb-3 flex items-center gap-3">
          <span class="h-px w-12 bg-brand-light"></span>
          <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">04 / Who we serve</span>
        </div>
        <h2 class="font-display text-3xl font-bold text-white md:text-5xl">
          Sectors we <span class="text-brand">serve</span>
        </h2>
        <p class="mt-4 text-base text-slate-400 md:mt-6 md:text-lg">
          We speak both to those who need a product and to those who need to solve a larger-scale electrical project.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4 lg:grid-cols-7">
        {sectors.map((s) => (
          <div class="group flex flex-col items-center justify-center border border-steel-600 bg-steel-800 p-4 text-center transition-all hover:border-brand hover:bg-brand/5 md:p-6">
            <div class="mb-2 flex h-10 w-10 items-center justify-center text-brand transition-transform group-hover:scale-110 md:mb-3">
              {s.icon === 'factory' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V10l5 3V10l5 3V7l5 3v11" /></svg>}
              {s.icon === 'mine' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L4 9l8 13 8-13-8-7zM4 9h16" /></svg>}
              {s.icon === 'energy' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 2L3 14h7v8l10-12h-7V2z" /></svg>}
              {s.icon === 'construction' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M6 21V11l6-4 6 4v10M9 21v-6h6v6" /></svg>}
              {s.icon === 'plant' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V8h6v13M11 21V11h6v10M8 12h0M14 15h0" /></svg>}
              {s.icon === 'engineering' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19" /></svg>}
              {s.icon === 'maintenance' && <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 7l-5 5 5 5M19 7l-5 5 5 5" /></svg>}
            </div>
            <span class="text-xs font-medium text-slate-300 transition-colors group-hover:text-white md:text-sm">{s.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ABOUT US ============ -->
  <section id="nosotros" class="relative overflow-hidden bg-steel-800 py-16 md:py-24">
    <div class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-20"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-6">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-20">
        <div>
          <div class="mb-3 flex items-center gap-3">
            <span class="h-px w-12 bg-brand-light"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">05 / About Us</span>
          </div>
          <h2 class="font-display text-3xl font-bold text-white md:text-5xl">
            A <span class="text-brand">serious</span>, technical and prepared company
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-400 md:mt-6 md:text-lg">
            PyP Electricidad S.R.L. is a Tucumán-based company with over 15 years of experience.
            We pursue excellence, growth and customer satisfaction in every project.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 md:mt-10 md:gap-4">
            {traits.map((t) => (
              <div class="border border-steel-600 bg-steel-900 p-4 md:p-5">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 bg-brand-light"></span>
                  <h3 class="font-display text-base font-bold text-white md:text-lg">{t.name}</h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">{t.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-4 md:gap-6">
          <div class="grid gap-3 md:gap-4">
            <div class="industrial-corner relative aspect-video overflow-hidden border border-brand/20">
              <img src={img('nosotros-charla.jpg')} alt="Technical talk at PyP" class="h-full w-full object-cover" />
              <div class="absolute bottom-3 left-3 bg-steel-900/80 px-3 py-1 font-mono text-xs text-brand-light">Technical talk</div>
            </div>
            <div class="industrial-corner relative aspect-video overflow-hidden border border-brand/20">
              <img src={img('nosotros-control.jpg')} alt="Technical inspection at PyP" class="h-full w-full object-cover" />
              <div class="absolute bottom-3 left-3 bg-steel-900/80 px-3 py-1 font-mono text-xs text-brand-light">Technical inspection</div>
            </div>
          </div>

          <div class="border border-brand/20 bg-steel-900 p-5 md:p-6">
            <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-brand-light">Our backing</h3>
            <ul class="grid gap-2 sm:grid-cols-2">
              {backing.map((b) => (
                <li class="flex items-start gap-2 text-sm text-slate-300">
                  <span class="mt-0.5 text-brand">✓</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <div class="mt-5 border-t border-steel-700 pt-5">
