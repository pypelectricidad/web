---
import PageLayout from '../layouts/PageLayout.astro';
import productos from '../data/productos.json';
import posts from '../data/posts.json';
import catMap from '../data/redirects-category.json';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// Fallback map for any legacy URL variant the redirect pages didn't cover
const map = {};
for (const p of productos) {
  const w = p.sourceUrl?.split('/product-page/')[1];
  if (w) map[`/product-page/${w}`] = `${base}tienda/${p.slug}`;
}
for (const p of posts) map[`/post/${p.wixSlug}`] = `${base}blog/${p.slug}`;
for (const [slug, fam] of Object.entries(catMap)) {
  map[`/category/${slug}`] = fam ? `${base}tienda/?familia=${fam}` : `${base}tienda`;
}
---

<PageLayout title="Página no encontrada — PyP Electricidad" pageTitle="404" pageSubtitle="La página que buscás no existe">
  <section class="bg-steel-900">
    <div class="mx-auto max-w-2xl px-4 py-24 text-center md:px-6">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-brand-light">Error 404</p>
      <h1 class="mt-4 font-display text-3xl font-bold text-white">Página no encontrada</h1>
      <p class="mt-4 text-slate-400">El contenido pudo haberse movido. Probá el catálogo o volvé al inicio.</p>
      <div class="mt-8 flex justify-center gap-4">
        <a href={base} class="rounded bg-brand px-6 py-3 font-display font-bold text-white transition-colors hover:bg-brand-light">Ir al inicio</a>
        <a href={`${base}tienda`} class="rounded border border-steel-600 px-6 py-3 font-display font-bold text-slate-300 transition-colors hover:border-brand hover:text-white">Ver catálogo</a>
      </div>
    </div>
  </section>
  <script define:vars={{ map, base }}>
    const path = location.pathname.replace(/^\/web/, '').replace(/\/$/, '') || '/';
    const decoded = decodeURIComponent(path);
    const target = map[path] || map[decoded] || map[decoded + '/'];
    if (target) location.replace(target);
  </script>
</PageLayout>
