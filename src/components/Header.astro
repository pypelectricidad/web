---
// Normaliza BASE_URL para que siempre termine con una sola barra
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const nav = [
  { href: base, label: 'Home' },
  { href: `${base}tienda`, label: 'Tienda' },
  { href: `${base}servicios`, label: 'Servicios' },
  { href: `${base}nosotros`, label: 'Quiénes somos' },
  { href: `${base}blog`, label: 'Blog' },
];
---

<header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={`${base}`} class="flex items-center gap-2 font-semibold text-brand">
      <span class="inline-block h-8 w-8 rounded bg-brand text-white grid place-items-center">P</span>
      <span>PyP Electricidad</span>
    </a>
    <nav class="hidden md:flex gap-6 text-sm">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-brand transition-colors">{item.label}</a>
      ))}
    </nav>
  </div>
</header>
