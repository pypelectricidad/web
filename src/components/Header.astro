---
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const nav = [
  { href: base, label: 'Inicio' },
  { href: `${base}tienda`, label: 'Tienda' },
  { href: `${base}servicios`, label: 'Servicios' },
  { href: `${base}nosotros`, label: 'Nosotros' },
  { href: `${base}blog`, label: 'Blog' },
  { href: `${base}contacto`, label: 'Contacto' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-brand/20 bg-steel-900/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2 md:px-6">
    <!-- Logo oficial -->
    <a href={base} class="group flex items-center">
      <img src={`${base}images/logo-pyp-white.png`} alt="PyP Electricidad S.R.L." class="h-10 w-auto transition-opacity group-hover:opacity-80 md:h-12" />
    </a>

    <!-- Nav desktop -->
    <nav class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="relative px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:text-brand-light"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA + mobile toggle -->
    <div class="flex items-center gap-3">
      <a
        href={`${base}contacto`}
        class="hidden bg-brand px-5 py-2 font-display text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-brand-light md:inline-block"
      >
        Presupuesto
      </a>
      <button
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center border border-brand/30 text-brand md:hidden"
        aria-label="Abrir menú"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Línea decorativa inferior -->
  <div class="h-[2px] w-full bg-gradient-to-r from-brand-dark via-brand to-brand-light opacity-60"></div>

  <!-- Nav mobile -->
  <nav id="mobile-nav" class="hidden border-t border-brand/20 bg-steel-900 md:hidden">
    {nav.map((item) => (
      <a
        href={item.href}
        class="block border-b border-steel-700 px-6 py-3 text-sm font-medium text-slate-300 transition-colors hover:bg-steel-800 hover:text-brand-light"
      >
        {item.label}
      </a>
    ))}
    <a
      href={`${base}contacto`}
      class="block bg-brand px-6 py-4 font-display text-sm font-bold uppercase tracking-wider text-white"
    >
      Solicitar presupuesto
    </a>
  </nav>
</header>

<script is:inline>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-nav')?.classList.toggle('hidden');
  });
</script>
