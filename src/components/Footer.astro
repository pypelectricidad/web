---
import { translations, type Locale } from '../i18n/ui';

export interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const t = translations[locale];
const year = new Date().getFullYear();

const rawBase = import.meta.env.BASE_URL ?? '/';
const rawBaseClean = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const base = locale === 'es' ? rawBaseClean : `${rawBaseClean}en/`;
const imgBase = `${rawBaseClean}images/`;
---

<footer class="border-t border-brand/20 bg-steel-900">
  <!-- Banda decorativa azul -->
  <div class="h-2 bg-hazard-stripes"></div>

  <div class="mx-auto max-w-7xl px-4 py-12 md:px-6">
    <div class="grid gap-8 md:grid-cols-4">
      <!-- Marca -->
      <div class="md:col-span-1">
        <img src={`${imgBase}logo-pyp-white.png`} alt="PyP Electricidad S.R.L." class="h-14 w-auto" />
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
          {t.footerDesc}
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-brand-light">{t.navTitle}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={base} class="text-slate-400 transition-colors hover:text-brand-light">{t.nav.inicio}</a></li>
          <li><a href={`${base}servicios`} class="text-slate-400 transition-colors hover:text-brand-light">{t.nav.servicios}</a></li>
          <li><a href={`${base}nosotros`} class="text-slate-400 transition-colors hover:text-brand-light">{t.nav.nosotros}</a></li>
          <li><a href={`${base}blog`} class="text-slate-400 transition-colors hover:text-brand-light">{t.nav.blog}</a></li>
          <li><a href={`${base}ayuda`} class="text-slate-400 transition-colors hover:text-brand-light">{t.nav.ayuda}</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-brand-light">{t.contactoTitle}</h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-brand">▸</span>
            <span>Av. Siria 1699, San Miguel de Tucumán</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-brand">▸</span>
            <span>Cerrillos, Salta</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-brand">▸</span>
            <a href="mailto:ventas@pyp-argentina.com.ar" class="transition-colors hover:text-brand-light">ventas@pyp-argentina.com.ar</a>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-brand">▸</span>
            <a href="tel:+543814275594" class="transition-colors hover:text-brand-light">+54 381 427 5594</a>
          </li>
        </ul>
      </div>

      <!-- Sello ISO oficial + redes -->
      <div>
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-brand-light">{t.certificacionesTitle}</h3>
        <img src={`${imgBase}sello-trinorma.png`} alt="ISO 9001, ISO 14001, ISO 45001 — Bureau Veritas Certification" class="mb-4 max-h-28 w-auto" />
        <div class="flex gap-3">
          <a href="https://www.facebook.com/pypelectricidad" target="_blank" rel="noopener" class="flex h-8 w-8 items-center justify-center border border-brand/30 text-brand transition-colors hover:border-brand-light hover:text-brand-light" aria-label="Facebook">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a href="https://www.instagram.com/pyp.electricidad/" target="_blank" rel="noopener" class="flex h-8 w-8 items-center justify-center border border-brand/30 text-brand transition-colors hover:border-brand-light hover:text-brand-light" aria-label="Instagram">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/pyp-electricidad" target="_blank" rel="noopener" class="flex h-8 w-8 items-center justify-center border border-brand/30 text-brand transition-colors hover:border-brand-light hover:text-brand-light" aria-label="LinkedIn">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.youtube.com/@pypelectricidad" target="_blank" rel="noopener" class="flex h-8 w-8 items-center justify-center border border-brand/30 text-brand transition-colors hover:border-brand-light hover:text-brand-light" aria-label="YouTube">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Línea inferior -->
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-steel-700 pt-6 md:flex-row">
      <p class="font-mono text-xs text-slate-500">
        &copy; {year} PyP Electricidad S.R.L. — {t.derechos}
      </p>
      <p class="font-mono text-xs text-slate-500">
        {t.certLine}
      </p>
    </div>
  </div>

  <!-- Pie de página trinorma oficial -->
  <div class="border-t border-steel-700 bg-steel-900 px-4 py-4 md:px-6">
    <div class="mx-auto max-w-7xl">
      <img src={`${imgBase}pie-trinorma.png`} alt="ISO 9001, ISO 14001, ISO 45001 — Bureau Veritas Certification" class="mx-auto h-auto w-full max-w-5xl" />
    </div>
  </div>
</footer>
